# ================================================================
# LilyJoe Textiles ERP - Environment Configuration Example
# ================================================================

# --- Supabase PostgreSQL Connection (Recommended for Production) ---
# Direct connection string from Supabase Project Settings -> Database -> Connection string (URI)
# Note: Use transaction pooler (port 65432) or session pooler (port 5432)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:65432/postgres?sslmode=require

# --- Alternative: Individual Database Variables ---
DB_DRIVER=pgsql
DB_HOST=aws-0-[REGION].pooler.supabase.com
DB_PORT=65432
DB_NAME=postgres
DB_USER=postgres.[YOUR-PROJECT-REF]
DB_PASS=[YOUR-PASSWORD]
DB_SSLMODE=require

# --- For Local XAMPP MySQL (Defaults automatically if no env set) ---
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=lilyjoe_textiles
# DB_USER=root
# DB_PASS=

# --- Application Settings ---
APP_ENV=production
APP_TIMEZONE=Africa/Nairobi
APP_CURRENCY=KES
